/* Generated by tools/generate_glass.py — light Spotlight. */
* {
  font: "Inter 11";
  background-color: transparent;
  text-color: #1d1d1f;
  border: 0; margin: 0; padding: 0;
}
window {
  width: 620px;
  border-radius: 20px;
  background-color: rgba(255, 252, 254, 0.930);
  border: 1px;
  border-color: rgba(220, 215, 182, 0.650);
  padding: 14px;
}
inputbar {
  background-color: rgba(220, 215, 182, 0.350);
  border-radius: 12px;
  padding: 10px 14px;
  spacing: 10px;
  children: [ prompt, entry ];
}
prompt { text-color: rgba(60,60,67,0.58); }
entry { text-color: #1d1d1f; placeholder: "Spotlight Search"; placeholder-color: rgba(60,60,67,0.58); }
listview {
  lines: 8; columns: 1; spacing: 2px; padding: 10px 2px 2px 2px;
  scrollbar: false; dynamic: true;
}
element { padding: 7px 10px; spacing: 10px; border-radius: 9px; }
element-icon { size: 26px; }
element selected { background-color: rgba(9, 126, 250, 0.900); text-color: #ffffff; }
element-text { text-color: inherit; vertical-align: 0.5; }
element-text selected { text-color: #ffffff; }
