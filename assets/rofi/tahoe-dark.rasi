/* Generated by tools/generate_glass.py — dark Spotlight. */
* {
  font: "Inter 11";
  background-color: transparent;
  text-color: #f5f5f7;
  border: 0; margin: 0; padding: 0;
}
window {
  width: 620px;
  border-radius: 20px;
  background-color: rgba(33, 33, 45, 0.900);
  border: 1px;
  border-color: rgba(136, 151, 207, 0.220);
  padding: 14px;
}
inputbar {
  background-color: rgba(136, 151, 207, 0.100);
  border-radius: 12px;
  padding: 10px 14px;
  spacing: 10px;
  children: [ prompt, entry ];
}
prompt { text-color: rgba(235,235,245,0.58); }
entry { text-color: #f5f5f7; placeholder: "Spotlight Search"; placeholder-color: rgba(235,235,245,0.58); }
listview {
  lines: 8; columns: 1; spacing: 2px; padding: 10px 2px 2px 2px;
  scrollbar: false; dynamic: true;
}
element { padding: 7px 10px; spacing: 10px; border-radius: 9px; }
element-icon { size: 26px; }
element selected { background-color: rgba(13, 119, 238, 0.900); text-color: #ffffff; }
element-text { text-color: inherit; vertical-align: 0.5; }
element-text selected { text-color: #ffffff; }
